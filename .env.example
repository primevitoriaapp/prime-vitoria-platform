NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Em producao, `x-role` / `x-user-id` so funcionam na API se `true` (use JWT como caminho principal).
TRUST_HEADER_AUTH=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Monitorização (Sentry) — opcional; sem DSN o SDK não inicializa
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Auth token só para upload de source maps no CI (opcional)
SENTRY_AUTH_TOKEN=

# Seed staging (nunca em produção sem controlo): npm run seed:staging
# STAGING_SEED_ENABLED=true
# STAGING_SEED_PASSWORD=              # min 12 caracteres; mesma para os 4 users de teste
# STAGING_SEED_RESET_PASSWORD=       # opcional: true para forçar atualização da password

# Lista opcional de IPs que podem chamar /api/integrations/* (se vazia, qualquer IP).
# Exemplo: ERP_INTEGRATION_ALLOWED_IPS=203.0.113.1,198.51.100.2
ERP_INTEGRATION_ALLOWED_IPS=

# Scheduler: POST /api/jobs/erp/process com Authorization: Bearer <mesmo valor>
ERP_JOB_PROCESS_SECRET=
# POST /api/jobs/notifications/process
NOTIFICATION_JOB_PROCESS_SECRET=
# POST /api/jobs/reconcile/run
RECONCILE_JOB_PROCESS_SECRET=
# POST /api/jobs/dispatch-direct-scan (cron/worker: Authorization: Bearer)
# Local: gerado automaticamente em .env.local ao correr `npm run env:ensure-dispatch-scan-secret` ou `npm run dev`.
# Produção: defina no painel do host ou secrets manager (nunca no repositório). Mínimo 256 bits aleatórios.
DISPATCH_DIRECT_SCAN_SECRET=
# Crons Vercel (GET /api/cron/*) — Authorization: Bearer <valor>. Ver docs/VERCEL_CRONS.md
CRON_SECRET=

# Push motorista (FCM HTTP legacy `fcm/send`). Obrigatorio para envio real em `POST /api/jobs/notifications/process`.
FCM_SERVER_KEY=
# Firebase Web (PWA motorista — auto-registo em /driver). Chave VAPID = Web Push certificates no Firebase Console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FCM_VAPID_KEY=
# Reservado para FCM HTTP v1 / credenciais de servico (nao usado pelo processor atual).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Omie (conta a receber - IncluirContaReceber) ---
# Webhooks inbound (HMAC SHA256 do body)
ERP_WEBHOOK_SECRET=
ERP_OMIE_WEBHOOK_SECRET=
ERP_CONTA_AZUL_WEBHOOK_SECRET=

ERP_OMIE_APP_KEY=
ERP_OMIE_APP_SECRET=
# Codigo numerico do cliente no Omie (opcional se usar POST /api/integrations/mappings por cliente)
ERP_OMIE_CODIGO_CLIENTE_FORNECEDOR=
ERP_OMIE_CODIGO_CATEGORIA=
ERP_OMIE_ID_CONTA_CORRENTE=
# Opcional: URL da API (default oficial Omie)
ERP_OMIE_API_URL=https://app.omie.com.br/api/v1/financas/contareceber/

# --- Conta Azul (venda POST /v1/venda) ---
# Token Bearer obtido via fluxo OAuth da Conta Azul (documentacao developers.contaazul.com)
ERP_CONTA_AZUL_ACCESS_TOKEN=
ERP_CONTA_AZUL_API_BASE_URL=https://api-v2.contaazul.com
# UUID do cliente e do item de servico/produto cadastrados no Conta Azul
ERP_CONTA_AZUL_ID_CLIENTE=
ERP_CONTA_AZUL_ID_ITEM_SERVICO=
# Opcional: numero fixo da venda; se vazio, chama GET /v1/venda/proximo-numero
ERP_CONTA_AZUL_NUMERO_VENDA=
ERP_CONTA_AZUL_SITUACAO_VENDA=APROVADO
ERP_CONTA_AZUL_TIPO_PAGAMENTO=PIX_PAGAMENTO_INSTANTANEO
ERP_CONTA_AZUL_OPCAO_CONDICAO=À vista
ERP_CONTA_AZUL_ID_CATEGORIA=
ERP_CONTA_AZUL_ID_CENTRO_CUSTO=
ERP_CONTA_AZUL_ID_CONTA_FINANCEIRA=

# Exigir credenciais live no npm run erp:preflight (staging/prod)
# ERP_REQUIRE_LIVE=true

# Legado OAuth app (nao usado diretamente pelo client HTTP atual; util para renovar token)
ERP_CONTA_AZUL_CLIENT_ID=
ERP_CONTA_AZUL_CLIENT_SECRET=
